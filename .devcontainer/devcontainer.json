{
	"name": "valeriocomo.dev",
	"runArgs": [
		"--name",
		"valeriocomo.dev"
	],
	"forwardPorts": [
		4321,
		3000
	],
	"remoteEnv": {
		"CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
		"GH_TOKEN": "${localEnv:GH_TOKEN}",
		"PATH": "${containerEnv:PNPM_HOME}:${containerEnv:PATH}"
	},
	"containerEnv": {
		"CHOKIDAR_USEPOLLING": "true",
		"PNPM_HOME": "/home/node/.local/share/pnpm"
	},
	"image": "mcr.microsoft.com/devcontainers/javascript-node:26-trixie",
	"features": {
		"ghcr.io/devcontainers-extra/features/firebase-cli:2": {},
		"ghcr.io/devcontainers/features/github-cli:1": {
			"installDirectlyFromGitHubRelease": true,
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/claude-code:2": {
			"version": "latest"
		}
	},
	"mounts": [
		"source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
		"source=${localWorkspaceFolderBasename}-pnpm-store,target=${containerWorkspaceFolder}/.pnpm-store,type=volume"
	],
	"postCreateCommand": "sh ./.devcontainer/postCreateCommand.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"astro-build.astro-vscode",
				"github.vscode-github-actions",
				"github.vscode-pull-request-github",
				"redhat.vscode-yaml"
			],
			"settings": {
				"editor.formatOnSave": true,
				"[astro]": {
					"editor.codeActionsOnSave": {
						"source.organizeImports": "always"
					}
				}
			}
		}
	}
}